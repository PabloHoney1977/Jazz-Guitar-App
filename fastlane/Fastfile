# Store automation — App Store Connect + Google Play from store/store.yml.
#
#   bundle exec fastlane check                 validate store.yml + screenshots (no network)
#   bundle exec fastlane ios import            fill blanks/TODOs in store.yml from the live listing (read-only on Apple's side;
#                                              add force:true to take all live text, screenshots:true to download those too)
#   bundle exec fastlane ios status            show each version's review state
#   bundle exec fastlane ios metadata          push text (+ screenshots if present) to the version in store.yml
#   bundle exec fastlane ios submit            push metadata, attach the newest build, submit for review
#   bundle exec fastlane android import        pull the live Play listing INTO store.yml
#   bundle exec fastlane android metadata      push the Play listing text + graphics
#   bundle exec fastlane android release aab:path/app.aab [track:internal]
#   bundle exec fastlane android promote from:internal to:production [rollout:0.2]
#
# Credentials come from environment variables only (never commit them):
#   ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_CONTENT (the .p8 text) or ASC_KEY_PATH
#   PLAY_JSON_KEY_DATA (service-account JSON text) or PLAY_JSON_KEY_PATH

require_relative "storekit"

ROOT = File.expand_path("..", __dir__)
CFG_PATH = ENV["STORE_YML"] || File.join(ROOT, "store", "store.yml")
BUILD = File.join(ROOT, "fastlane", "build")

default_platform(:ios)
opt_out_usage

def cfg = StoreKit.load(CFG_PATH)

def require_valid!(platform)
  errors, warnings = StoreKit.validate(cfg, root: ROOT, platforms: [platform])
  warnings.each { |w| UI.important("⚠️  #{w}") }
  return if errors.empty?

  errors.each { |e| UI.error("✗ #{e}") }
  UI.user_error!("store.yml has #{errors.size} problem(s) — fix them before uploading")
end

# ---- Apple credentials ----------------------------------------------------

def asc_key_hash
  key = ENV["ASC_KEY_CONTENT"]
  key = File.read(ENV["ASC_KEY_PATH"]) if (key.nil? || key.empty?) && ENV["ASC_KEY_PATH"]
  UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_CONTENT (or ASC_KEY_PATH)") unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && key
  { key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key: key.gsub("\\n", "\n"), in_house: false }
end

def asc_api_key
  @asc_api_key ||= begin
    h = asc_key_hash
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**h)
    app_store_connect_api_key(key_id: h[:key_id], issuer_id: h[:issuer_id], key_content: h[:key], in_house: false)
  end
end

# deliver's CLI commands want the key as a JSON file; written to the gitignored build dir, removed after.
def with_asc_key_file
  FileUtils.mkdir_p(BUILD)
  path = File.join(BUILD, "asc_key.json")
  File.write(path, JSON.generate(asc_key_hash))
  File.chmod(0o600, path)
  yield path
ensure
  FileUtils.rm_f(path) if path
end

def play_key
  data = ENV["PLAY_JSON_KEY_DATA"]
  data = File.read(ENV["PLAY_JSON_KEY_PATH"]) if (data.nil? || data.empty?) && ENV["PLAY_JSON_KEY_PATH"]
  UI.user_error!("Set PLAY_JSON_KEY_DATA (or PLAY_JSON_KEY_PATH)") if data.nil? || data.empty?
  data
end

# ---- shared ---------------------------------------------------------------

desc "Validate store.yml and screenshots for both stores (offline)"
lane :check do
  errors, warnings = StoreKit.validate(cfg, root: ROOT)
  warnings.each { |w| UI.important("⚠️  #{w}") }
  errors.each { |e| UI.error("✗ #{e}") }
  UI.user_error!("#{errors.size} problem(s) in store.yml") unless errors.empty?
  UI.success("store.yml looks good (#{cfg['listings'].keys.join(', ')})")
end

# ---- iOS ------------------------------------------------------------------

platform :ios do
  def bundle_id = cfg.dig("app", "ios_bundle_id") || UI.user_error!("app.ios_bundle_id missing in store.yml")
  def ios_version = cfg.dig("ios", "version") || UI.user_error!("ios.version missing in store.yml (the version you're shipping, e.g. 2.1)")
  def ios_meta = File.join(BUILD, "ios", "metadata")
  def ios_shots = File.join(ROOT, "store", "screenshots", "ios")

  def deliver_options(submit:)
    c = cfg
    StoreKit.write_ios(c, ios_meta)
    have_shots = Dir[File.join(ios_shots, "*", "*.png")].any?
    rating = File.join(BUILD, "ios", "age_rating.json")
    opts = {
      api_key: asc_api_key,
      app_identifier: bundle_id,
      app_version: ios_version,
      metadata_path: ios_meta,
      screenshots_path: ios_shots,
      skip_screenshots: !have_shots,
      overwrite_screenshots: have_shots,
      skip_binary_upload: true,
      skip_app_version_update: false, # creates the version in App Store Connect if it doesn't exist yet
      force: true,                    # no HTML preview / prompt — this runs unattended
      ignore_language_directory_validation: false,
      precheck_include_in_app_purchases: false, # not checkable with an API key
      submit_for_review: submit,
      run_precheck_before_submit: submit,
      automatic_release: c.dig("ios", "automatic_release") == true,
      phased_release: c.dig("ios", "phased_release") == true,
      reset_ratings: false
    }
    opts[:app_rating_config_path] = rating if File.exist?(rating)
    opts
  end

  desc "Download the live App Store listing into store.yml (changes nothing on Apple's side)"
  lane :import do |options|
    dir = File.join(BUILD, "ios", "import")
    FileUtils.rm_rf(dir)
    with_asc_key_file do |key|
      sh("fastlane", "deliver", "download_metadata", "--api_key_path", key, "--app_identifier", bundle_id,
         "--metadata_path", dir, "--force", "true")
      if [true, "true"].include?(options[:screenshots])
        sh("fastlane", "deliver", "download_screenshots", "--api_key_path", key, "--app_identifier", bundle_id,
           "--screenshots_path", ios_shots, "--force", "true")
      end
    end
    StoreKit.save(StoreKit.import_ios(cfg, dir, overwrite: [true, "true"].include?(options[:force])), CFG_PATH)
    UI.success("Updated #{CFG_PATH} from the live listing — review the diff, then commit")
  end

  desc "Show every App Store version and its review state"
  lane :status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(bundle_id) || UI.user_error!("No app with bundle ID #{bundle_id} in App Store Connect — create the app record first (see MANUAL_STEPS.md)")
    app.get_app_store_versions(limit: 5).each do |v|
      state = v.respond_to?(:app_version_state) && v.app_version_state ? v.app_version_state : v.app_store_state
      UI.message("#{v.version_string.ljust(8)} #{state}")
    end
    begin
      b = latest_testflight_build_number(api_key: asc_api_key, app_identifier: bundle_id, version: ios_version)
      UI.message("Newest build for #{ios_version}: #{b}")
    rescue StandardError => e
      UI.important("No build found for #{ios_version} yet (#{e.message.lines.first&.strip})")
    end
  end

  desc "Push store.yml text (and screenshots, if any) to the App Store version — does not submit"
  lane :metadata do
    require_valid!("ios")
    deliver(**deliver_options(submit: false))
  end

  desc "Push metadata, attach the newest processed build for ios.version, and submit for review"
  lane :submit do |options|
    require_valid!("ios")
    build = options[:build] || latest_testflight_build_number(api_key: asc_api_key, app_identifier: bundle_id, version: ios_version)
    UI.message("Submitting #{ios_version} (#{build}) for review")
    deliver(**deliver_options(submit: true).merge(
      build_number: build.to_s,
      submission_information: { add_id_info_uses_idfa: cfg.dig("ios", "uses_idfa") == true }
    ))
    UI.success("Submitted. Release stays manual unless ios.automatic_release is true.")
  end
end

# ---- Android --------------------------------------------------------------

platform :android do
  def play_package = cfg.dig("app", "android_package") || UI.user_error!("app.android_package missing in store.yml")
  def and_meta = File.join(BUILD, "android", "metadata")

  desc "Download the live Play listing into store.yml"
  lane :import do |options|
    dir = File.join(BUILD, "android", "import")
    FileUtils.rm_rf(dir)
    download_from_play_store(package_name: play_package, json_key_data: play_key, metadata_path: dir)
    StoreKit.save(StoreKit.import_android(cfg, dir, overwrite: [true, "true"].include?(options[:force])), CFG_PATH)
    UI.success("Updated #{CFG_PATH} from the live Play listing — review the diff, then commit")
  end

  desc "Push the Play listing text and graphics (no release)"
  lane :metadata do
    require_valid!("android")
    StoreKit.write_android(cfg, and_meta, root: ROOT)
    upload_to_play_store(
      package_name: play_package, json_key_data: play_key, metadata_path: and_meta,
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_changelogs: true,
      sync_image_upload: true
    )
  end

  desc "Upload an .aab to a track. aab:path (required), track:internal|alpha|beta|production, status:draft|completed"
  lane :release do |options|
    aab = options[:aab] || UI.user_error!("Pass aab:path/to/app-release.aab")
    require_valid!("android")
    StoreKit.write_android(cfg, and_meta, root: ROOT)
    upload_to_play_store(
      package_name: play_package, json_key_data: play_key, metadata_path: and_meta, aab: File.expand_path(aab, ROOT),
      track: options[:track] || "internal",
      # Google only accepts "draft" until the app has been published once.
      release_status: options[:status] || cfg.dig("android", "release_status") || "completed",
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc "Promote the newest release between tracks. from:internal to:production [rollout:0.1]"
  lane :promote do |options|
    from = options[:from] || "internal"
    to = options[:to] || "production"
    codes = google_play_track_version_codes(package_name: play_package, json_key_data: play_key, track: from)
    UI.user_error!("Nothing on #{from} to promote") if codes.empty?
    args = { package_name: play_package, json_key_data: play_key, track: from, track_promote_to: to,
             version_code: codes.max, skip_upload_metadata: true, skip_upload_images: true,
             skip_upload_screenshots: true, skip_upload_changelogs: true }
    args[:rollout] = options[:rollout].to_s if options[:rollout]
    upload_to_play_store(**args)
  end
end
